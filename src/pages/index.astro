---
import Layout from '../layouts/Layout.astro';
import { site, url, photoUrl } from '../data/site';
import { featuredResearch, researchTypeLabel } from '../data/research';
import { posts } from '../data/posts';
import { albums, coverOf } from '../data/photos';
const selectedAlbums = albums.slice(0, 3);
---
<Layout wide>
  <section class="home-intro" aria-labelledby="name">
    <div class="intro-name">
      <p class="eyebrow">Personal website</p>
      <h1 id="name">Xiangtong<br /><span>Nie</span><span class="name-period" aria-hidden="true">.</span></h1>
    </div>
    <div class="intro-profile">
      <p class="eyebrow">Currently at</p>
      <p class="intro-affiliation">University of Chinese<br class="desktop-break" /> Academy of Sciences</p>
      <p class="intro-bio">Previously, I studied Intelligent Science and Technology at Shanghai University.</p>
      <div class="contact-links">
        <a href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={url('about/')}>About me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <div class="home-editorial-grid">
    <section class="research-preview" aria-labelledby="research-heading">
      <div class="section-topline"><h2 id="research-heading" class="eyebrow">Research</h2><span class="section-descriptor">Interests & work</span></div>
      <p class="research-statement">Artificial intelligence.<br /><em>Industrial applications.</em></p>
      {featuredResearch.length > 0 && <div class="research-list">
        {featuredResearch.map(item => <article class="research-item">
          <p class="research-meta">{item.year} · {researchTypeLabel[item.type]}</p>
          <h3><a href={url(`research/${item.slug}/`)}>{item.title}</a></h3>
          {item.authors && <p class="research-authors">{item.authors.join(', ')}</p>}
          {item.venue && <p class="research-venue">{item.venue}</p>}
          <p class="research-summary">{item.summary}</p>
        </article>)}
      </div>}
      <a class="text-link" href={url('research/')}>Research & projects <span aria-hidden="true">↗</span></a>
    </section>
    <section class="writing-preview" aria-labelledby="writing-heading">
      <div class="section-topline"><h2 id="writing-heading" class="eyebrow">Writing</h2></div>
      <p class="writing-statement">Notes<br /><em>& essays.</em></p>
      {posts.length > 0 ? <div class="text-list">
        {posts.slice(0, 3).map(post => <a class="article-row" href={url(`p/${post.slug}/`)}><h3>{post.title}</h3>{post.date && <time datetime={post.date.slice(0, 10)}>{post.date.slice(0, 10)}</time>}</a>)}
      </div> : <p class="section-copy quiet">No published writing yet.</p>}
      <a class="text-link" href={url('writing/')}>Writing archive <span aria-hidden="true">↗</span></a>
    </section>
  </div>

  {selectedAlbums.length > 0 && <section class="photography-preview" aria-labelledby="photography-heading">
    <div class="photography-heading">
      <div><p class="eyebrow">Away from the desk</p><h2 id="photography-heading">Photography</h2></div>
      <a class="text-link" href={url('photography/')}>Browse the collections <span aria-hidden="true">↗</span></a>
    </div>
    <div class="photo-preview-grid">
      {selectedAlbums.map(album => {
        const photo = coverOf(album);
        return <a href={url(`series/${album.slug}/`)} class="photo-preview-item">
          <div class="photo-preview-image"><img src={photoUrl(photo.src)} srcset={photo.variants?.map(v => `${photoUrl(v.src)} ${v.width}w`).join(', ')} sizes="(max-width: 640px) calc(100vw - 80px), (max-width: 1000px) 40vw, 360px" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></div>
          <div class="photo-preview-caption"><span>{album.title}</span><span class="photo-preview-meta">{album.demo ? 'Sample collection' : album.year} <span aria-hidden="true">↗</span></span></div>
        </a>;
      })}
    </div>
    {selectedAlbums.some(album => album.demo) && <p class="sample-note">Sample photographs from Unsplash. Photographer credits are included in each collection.</p>}
  </section>}
</Layout>
