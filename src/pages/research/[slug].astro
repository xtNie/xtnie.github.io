---
import type {GetStaticPaths} from 'astro';
import AcademicLayout from '../../layouts/AcademicLayout.astro';
import {researchItems,researchTypeLabel,researchLinkLabel,type ResearchItem,type ResearchLink} from '../../data/research';
import {site,url} from '../../data/site';
export const getStaticPaths=(()=>researchItems.map(item=>({params:{slug:item.slug},props:{item}}))) satisfies GetStaticPaths;
interface Props {item:ResearchItem}
const {item}=Astro.props;
---
<AcademicLayout title={`${item.title} — ${site.name}`} description={item.summary}>
  <Fragment slot="head">
    {item.type==='paper'&&<>
      <meta name="citation_title" content={item.title} />
      {item.authors?.map(author=><meta name="citation_author" content={author} />)}
      <meta name="citation_publication_date" content={String(item.year)} />
    </>}
  </Fragment>
  <article class="academic-detail">
    <p class="academic-back"><a href={url('research/')}>Xiangtong Nie / Research</a></p>
    <header>
      <h1>{item.title}</h1>
      {item.authors&&<p class="detail-authors">{item.authors.join(', ')}</p>}
      <p class="detail-meta">{researchTypeLabel[item.type]} · {item.venue&&<><em>{item.venue}</em> · </>}<time datetime={String(item.year)}>{item.year}</time>{item.status&&` · ${item.status}`}</p>
    </header>
    {Object.keys(item.links).length>0&&<nav class="resource-links" aria-label="Research resources">
      {Object.entries(item.links).map(([kind,href])=><a href={href}>{researchLinkLabel[kind as ResearchLink]}</a>)}
    </nav>}
    <div class="detail-summary">{item.summary.split(/\n\s*\n/).map(paragraph=><p>{paragraph}</p>)}</div>
  </article>
</AcademicLayout>
