---
import AcademicLayout from '../../layouts/AcademicLayout.astro';
import {researchItems,researchLinkLabel,type ResearchLink} from '../../data/research';
import {site,url} from '../../data/site';
const groups=[
  {title:'Publications',items:researchItems.filter(item=>item.type==='paper')},
  {title:'Projects',items:researchItems.filter(item=>item.type==='project')},
].filter(group=>group.items.length>0);
---
<AcademicLayout>
  <header class="academic-profile">
    <h1>Xiangtong Nie</h1>
    <p>I am currently at the University of Chinese Academy of Sciences (UCAS). Previously, I studied Intelligent Science and Technology at Shanghai University.</p>
    <p class="academic-contact"><a href={`mailto:${site.email}`}>Email</a><span aria-hidden="true">/</span><a href={site.github}>GitHub</a><span aria-hidden="true">/</span><a href={url()}>Personal website</a></p>
  </header>
  <section class="research-introduction" aria-labelledby="research-heading">
    <h2 id="research-heading">Research</h2>
    <p>I am interested in artificial intelligence and its applications in industrial settings.</p>
  </section>
  {groups.map(group=><section aria-labelledby={`${group.title.toLowerCase()}-heading`}>
    <h2 id={`${group.title.toLowerCase()}-heading`}>{group.title}</h2>
    <ul class="bibliography">
      {group.items.map(item=><li>
        <article>
          <h3><a href={url(`research/${item.slug}/`)}>{item.title}</a></h3>
          {item.authors&&<p>{item.authors.join(', ')}</p>}
          <p>{item.venue&&<><em>{item.venue}</em>, </>}{item.year}{item.status&&` · ${item.status}`}</p>
          {Object.keys(item.links).length>0&&<nav class="resource-links" aria-label={`Resources for ${item.title}`}>
            {Object.entries(item.links).map(([kind,href])=><a href={href}>{researchLinkLabel[kind as ResearchLink]}</a>)}
          </nav>}
          <p class="entry-summary">{item.summary}</p>
        </article>
      </li>)}
    </ul>
  </section>)}
</AcademicLayout>
