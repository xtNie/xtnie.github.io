---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';
import { url } from '../data/site';
---
<Layout title="Writing" active="writing">
  <header class="page-header"><h1>Writing</h1></header>
  {posts.length > 0 ? <section class="text-list">
    {posts.map(post => <a class="article-row" href={url(`p/${post.slug}/`)}>{post.date && <time datetime={post.date.slice(0, 10)}>{post.date.slice(0, 10)}</time>}<div><h2>{post.title}</h2>{post.description && <p>{post.description}</p>}</div></a>)}
  </section> : <p class="empty-note">No published posts yet.</p>}
</Layout>
