---
import Layout from '../layouts/Layout.astro';
import { site, url } from '../data/site';
---
<Layout title="About" active="about">
  <header class="page-header"><h1>About</h1></header>
  <article class="prose">
    <p>I am Xiangtong Nie, also known as Sutton.</p>
    <p>I enjoy photography and music, especially blues, jazz, and rock. I am also learning to play the bass.</p>
    <p>For my academic background and research interests, see my <a href={url('research/')}>research page</a>.</p>
    <h2>Contact</h2>
    <p><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.github} target="_blank" rel="noreferrer">GitHub</a></p>
  </article>
</Layout>
