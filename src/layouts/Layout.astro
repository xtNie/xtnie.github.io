---
import '../styles/global.css';
import { site, url } from '../data/site';
interface Props { title?: string; description?: string; active?: string; wide?: boolean }
const { title, description = site.description, active = 'home', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { key: 'research', label: 'Research', path: '' },
  { key: 'writing', label: 'Writing', path: 'writing/' },
  { key: 'photography', label: 'Photography', path: 'photography/' },
  { key: 'about', label: 'About', path: 'about/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="author" content={site.name} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { wide }]}>
      <a class="wordmark" href={url('personal/')} aria-label="Sutton — personal home">Sutton</a>
      <nav class="main-nav" aria-label="Main navigation">
        {links.map(link => <a href={url(link.path)} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
      </nav>
    </header>
    <main id="main" class:list={{ wide }}><slot /></main>
    <footer class:list={['site-footer', { wide }]}>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <div class="footer-links"><a href={`mailto:${site.email}`}>Email</a><a href={site.github} target="_blank" rel="noreferrer">GitHub</a></div>
    </footer>
  </body>
</html>
