---
import '../styles/academic.css';
import {site,url} from '../data/site';
interface Props {title?:string;description?:string}
const {title=`${site.name} — Research`,description=`${site.name}. University of Chinese Academy of Sciences. Research interests in artificial intelligence and industrial applications.`}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main class="academic-page" id="main"><slot /></main>
  </body>
</html>
